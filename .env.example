# Copy this file to `.env` and fill in what you need:  cp .env.example .env
#
# `.env` is in .gitignore and must never be committed. This file must never hold a real
# value: it ships in a public repository, and a test asserts nothing here looks like a
# credential.

# Required. Used by the default provider, anthropic:claude-sonnet-5.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional. Only if you point the agent at another provider.
OPENAI_API_KEY=sk-REPLACE_ME
GROQ_API_KEY=gsk-REPLACE_ME

# Optional. Total tokens one run may spend, as a safety limit rather than an allowance.
# ENVFORGE_TOKEN_BUDGET=256000
